{
  "name": "repocanvas-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.16"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace=@repocanvas/example",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@beetroot11/repocanvas",
    "test:e2e": "playwright test",
    "verify": "npm test && npm run typecheck && npm run build && npm run verify:package --workspace=@beetroot11/repocanvas && npm run verify:consumer --workspace=@beetroot11/repocanvas",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "latest"
  }
}
