{
  "name": "@beetroot11/repocanvas",
  "version": "0.2.0",
  "description": "A private visual notebook for every project.",
  "license": "MIT",
  "author": "Beetroot11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beetroot11/repocanvas.git"
  },
  "homepage": "https://github.com/Beetroot11/repocanvas#readme",
  "bugs": "https://github.com/Beetroot11/repocanvas/issues",
  "keywords": ["whiteboard", "excalidraw", "react", "diagram", "developer-tools"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["./dist/index.js", "./dist/editor.js", "./dist/library.js"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "repocanvas": "./scripts/repocanvas-cli.mjs"
  },
  "files": [
    "dist",
    "scripts/repocanvas-cli.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build && npm run verify:package",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "node ./scripts/verify-build.mjs",
    "verify:consumer": "node ./scripts/verify-consumer.mjs"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-css-injected-by-js": "^5.0.2"
  }
}
